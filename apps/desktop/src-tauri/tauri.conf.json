{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Blocks",
  "version": "0.1.0",
  "identifier": "dev.nexus.blocks",
  "build": {
    "beforeDevCommand": "pnpm --filter @nexus/editor dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @nexus/editor build",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus Blocks",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
