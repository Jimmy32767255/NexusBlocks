{
  "name": "nexus-blocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus Blocks — an extensible visual programming environment",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nexus/editor dev",
    "build": "pnpm --filter @nexus/editor build",
    "preview": "pnpm --filter @nexus/editor preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "bootstrap:check": "node tools/bootstrap-check.mjs",
    "bootstrap:self": "node tools/bootstrap-check.mjs --self",
    "desktop": "pnpm --filter @nexus/desktop dev",
    "desktop:build": "pnpm --filter @nexus/desktop build",
    "package": "node scripts/package.mjs",
    "package:linux": "node scripts/package.mjs linux",
    "package:windows": "node scripts/package.mjs windows",
    "package:all": "node scripts/package.mjs all",
    "cli:build": "pnpm --filter @nexus/cli exec node scripts/build.mjs",
    "cli:package": "pnpm --filter @nexus/cli exec node scripts/build.mjs && pnpm --filter @nexus/cli exec node scripts/compile.mjs",
    "cli:install": "pnpm cli:package && node packages/cli/scripts/install.mjs",
    "cli:package:windows": "pnpm --filter @nexus/cli exec node scripts/build.mjs && pnpm --filter @nexus/cli exec node scripts/compile.mjs windows"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
