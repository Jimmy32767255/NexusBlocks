项目 "nblk1"
语言 zh-CN

# nblk1：用 .nblk 写的 Nexus Blocks IR 解释器。
# 输入是 `nblk --json` 同构的项目 IR（JSON 文件），输出与原解释器一致。
#
# 运行：nblk bootstrap/nblk1.nblk 程序.ir.json
# 生成 IR：node tools/ir-dump.mjs 程序.nblk > 程序.ir.json

定义取值 是字典(nblk1_是字典_值) -> 布尔值:
  返回 类型(nblk1_是字典_值) == "字典"

定义取值 有(nblk1_有_容器, nblk1_有_键) -> 布尔值:
  如果 类型(nblk1_有_容器) != "字典":
    返回 假
  返回 有键(nblk1_有_容器, nblk1_有_键)

定义取值 字段(nblk1_字段_节点, nblk1_字段_名字) -> 任意:
  如果 有(nblk1_字段_节点, "fields") 并且 有(取值(nblk1_字段_节点, "fields"), nblk1_字段_名字):
    返回 取值(取值(nblk1_字段_节点, "fields"), nblk1_字段_名字)
  返回 空

定义取值 节点类型(nblk1_节点类型_节点) -> 文本:
  如果 类型(nblk1_节点类型_节点) != "字典":
    返回 ""
  如果 有键(nblk1_节点类型_节点, "type") == 假:
    返回 ""
  返回 取值(nblk1_节点类型_节点, "type")

定义取值 端口(nblk1_端口_节点, nblk1_端口_名字, nblk1_端口_环境) -> 任意:
  如果 有(nblk1_端口_节点, "inputs") 并且 有(取值(nblk1_端口_节点, "inputs"), nblk1_端口_名字):
    返回 求值(取值(取值(nblk1_端口_节点, "inputs"), nblk1_端口_名字), nblk1_端口_环境)
  返回 字段(nblk1_端口_节点, nblk1_端口_名字)

定义取值 真值(nblk1_真值_值) -> 布尔值:
  如果 nblk1_真值_值 == 空:
    返回 假
  创建局部变量 nblk1_真值_种 为 类型(nblk1_真值_值)
  如果 nblk1_真值_种 == "布尔值":
    返回 nblk1_真值_值
  如果 nblk1_真值_种 == "数字":
    返回 nblk1_真值_值 != 0
  如果 nblk1_真值_种 == "文本":
    返回 nblk1_真值_值 != ""
  如果 nblk1_真值_种 == "列表":
    返回 长度(nblk1_真值_值) > 0
  如果 nblk1_真值_种 == "字典":
    返回 长度(键列表(nblk1_真值_值)) > 0
  返回 真

定义取值 去空白(nblk1_去空白_g_文本) -> 文本:
  创建局部变量 nblk1_去空白_头 为 0
  创建局部变量 nblk1_去空白_尾 为 文本长度(nblk1_去空白_g_文本) - 1
  当 nblk1_去空白_头 <= nblk1_去空白_尾 并且 是空白(取字符(nblk1_去空白_g_文本, nblk1_去空白_头)):
    设置局部变量 nblk1_去空白_头 为 nblk1_去空白_头 + 1
  当 nblk1_去空白_尾 >= nblk1_去空白_头 并且 是空白(取字符(nblk1_去空白_g_文本, nblk1_去空白_尾)):
    设置局部变量 nblk1_去空白_尾 为 nblk1_去空白_尾 - 1
  如果 nblk1_去空白_头 > nblk1_去空白_尾:
    返回 ""
  返回 子串(nblk1_去空白_g_文本, nblk1_去空白_头, nblk1_去空白_尾 - nblk1_去空白_头 + 1)

定义取值 是空白(nblk1_是空白_字符) -> 布尔值:
  创建局部变量 nblk1_是空白_码 为 字符码(nblk1_是空白_字符)
  返回 nblk1_是空白_码 == 32 或者 nblk1_是空白_码 == 9 或者 nblk1_是空白_码 == 10 或者 nblk1_是空白_码 == 13

# ---- 变量作用域 ----

定义取值 读变量(nblk1_读变量_名字, nblk1_读变量_环境) -> 任意:
  创建局部变量 nblk1_读变量_i 为 长度(nblk1_读变量_环境) - 1
  当 nblk1_读变量_i >= 0:
    创建局部变量 nblk1_读变量_帧 为 取元素(nblk1_读变量_环境, nblk1_读变量_i)
    如果 有键(nblk1_读变量_帧, nblk1_读变量_名字):
      返回 取值(nblk1_读变量_帧, nblk1_读变量_名字)
    设置局部变量 nblk1_读变量_i 为 nblk1_读变量_i - 1
  抛出 连接("nblk1: 未定义变量 ", nblk1_读变量_名字)

定义取值 变量存在(nblk1_变量存在_名字: 文本, nblk1_变量存在_环境) -> 布尔值:
  创建局部变量 nblk1_变量存在_i 为 长度(nblk1_变量存在_环境) - 1
  当 nblk1_变量存在_i >= 0:
    创建局部变量 nblk1_变量存在_帧 为 取元素(nblk1_变量存在_环境, nblk1_变量存在_i)
    如果 有键(nblk1_变量存在_帧, nblk1_变量存在_名字):
      返回 真
    设置局部变量 nblk1_变量存在_i 为 nblk1_变量存在_i - 1
  返回 假

定义操作 赋值(nblk1_赋值_名字: 文本, nblk1_赋值_值: 任意, nblk1_赋值_环境):
  如果 变量存在(nblk1_赋值_名字, nblk1_赋值_环境):
    写变量(nblk1_赋值_名字, nblk1_赋值_值, nblk1_赋值_环境)
  否则:
    建全局(nblk1_赋值_名字, nblk1_赋值_值, nblk1_赋值_环境)

定义操作 写变量(nblk1_写变量_名字: 文本, nblk1_写变量_值: 任意, nblk1_写变量_环境):
  创建局部变量 nblk1_写变量_i 为 长度(nblk1_写变量_环境) - 1
  创建局部变量 nblk1_写变量_完成 为 假
  当 nblk1_写变量_i >= 0 并且 nblk1_写变量_完成 == 假:
    创建局部变量 nblk1_写变量_帧 为 取元素(nblk1_写变量_环境, nblk1_写变量_i)
    如果 有键(nblk1_写变量_帧, nblk1_写变量_名字):
      设置键(nblk1_写变量_帧, nblk1_写变量_名字, nblk1_写变量_值)
      设置局部变量 nblk1_写变量_完成 为 真
    否则:
      设置局部变量 nblk1_写变量_i 为 nblk1_写变量_i - 1
  如果 nblk1_写变量_完成 == 假:
    抛出 连接("nblk1: 未定义变量 ", nblk1_写变量_名字)

定义操作 建全局(nblk1_建全局_名字, nblk1_建全局_值, nblk1_建全局_环境):
  设置键(取元素(nblk1_建全局_环境, 0), nblk1_建全局_名字, nblk1_建全局_值)

定义操作 建局部(nblk1_建局部_名字, nblk1_建局部_值, nblk1_建局部_环境):
  如果 长度(nblk1_建局部_环境) == 0:
    抛出 "nblk1: 局部变量只能在函数内创建"
  设置键(取元素(nblk1_建局部_环境, 长度(nblk1_建局部_环境) - 1), nblk1_建局部_名字, nblk1_建局部_值)

# ---- 发现函数 ----

定义操作 装载(nblk1_装载_g_项目):
  设置 nblk1_g_函数表 为 {}
  设置 nblk1_g_参数表 为 {}
  重复 使用 nblk1_装载_i 共 长度(取值(nblk1_装载_g_项目, "scripts")) 次:
    创建局部变量 nblk1_装载_脚本 为 取元素(取值(nblk1_装载_g_项目, "scripts"), nblk1_装载_i)
    创建局部变量 nblk1_装载_种 为 取值(nblk1_装载_脚本, "type")
    如果 nblk1_装载_种 == "func.define_value" 或者 nblk1_装载_种 == "func.define_action":
      设置键(nblk1_g_函数表, 取值(nblk1_装载_脚本, "id"), nblk1_装载_脚本)
      设置键(nblk1_g_参数表, 取值(nblk1_装载_脚本, "id"), 解析参数(字段(nblk1_装载_脚本, "params")))

定义取值 解析参数(nblk1_解析参数_g_文本) -> 列表:
  创建局部变量 nblk1_解析参数_名字们 为 []
  如果 nblk1_解析参数_g_文本 == 空 或者 nblk1_解析参数_g_文本 == "":
    返回 nblk1_解析参数_名字们
  创建局部变量 nblk1_解析参数_段们 为 拆分为列表(nblk1_解析参数_g_文本, ",")
  重复 使用 nblk1_解析参数_i 共 长度(nblk1_解析参数_段们) 次:
    创建局部变量 nblk1_解析参数_段 为 去空白(取元素(nblk1_解析参数_段们, nblk1_解析参数_i))
    如果 nblk1_解析参数_段 != "":
      创建局部变量 nblk1_解析参数_冒号 为 查找(nblk1_解析参数_段, ":")
      如果 nblk1_解析参数_冒号 >= 0:
        添加(nblk1_解析参数_名字们, 去空白(子串(nblk1_解析参数_段, 0, nblk1_解析参数_冒号)))
      否则:
        添加(nblk1_解析参数_名字们, nblk1_解析参数_段)
  返回 nblk1_解析参数_名字们

# ---- 求值 ----

定义取值 求值(nblk1_求值_节点, nblk1_求值_环境) -> 任意:
  如果 类型(nblk1_求值_节点) != "字典":
    返回 nblk1_求值_节点
  创建局部变量 nblk1_求值_种 为 节点类型(nblk1_求值_节点)
  如果 nblk1_求值_种 == "":
    返回 nblk1_求值_节点

  如果 nblk1_求值_种 == "math.number":
    返回 字段(nblk1_求值_节点, "value")
  如果 nblk1_求值_种 == "text.literal":
    返回 字段(nblk1_求值_节点, "value")
  如果 nblk1_求值_种 == "logic.boolean":
    返回 字段(nblk1_求值_节点, "value")
  如果 nblk1_求值_种 == "raw":
    返回 字段(nblk1_求值_节点, "value")
  如果 nblk1_求值_种 == "list.literal":
    返回 解析JSON(字段(nblk1_求值_节点, "items"))
  如果 nblk1_求值_种 == "dict.literal":
    返回 解析JSON(字段(nblk1_求值_节点, "items"))
  如果 nblk1_求值_种 == "var.get":
    返回 读变量(字段(nblk1_求值_节点, "variable"), nblk1_求值_环境)
  如果 nblk1_求值_种 == "func.param":
    返回 读变量(字段(nblk1_求值_节点, "name"), nblk1_求值_环境)
  如果 nblk1_求值_种 == "sys.args":
    返回 nblk1_g_程序参数
  如果 nblk1_求值_种 == "time.get_os_time":
    返回 当前时间()

  如果 nblk1_求值_种 == "list.length":
    返回 长度(端口(nblk1_求值_节点, "items", nblk1_求值_环境))
  如果 nblk1_求值_种 == "list.get":
    创建局部变量 nblk1_求值_表 为 端口(nblk1_求值_节点, "items", nblk1_求值_环境)
    创建局部变量 nblk1_求值_下标 为 端口(nblk1_求值_节点, "index", nblk1_求值_环境)
    如果 类型(nblk1_求值_表) != "列表":
      抛出 "nblk1: 不是列表"
    如果 nblk1_求值_下标 < 0 或者 nblk1_求值_下标 >= 长度(nblk1_求值_表):
      抛出 "nblk1: 列表下标越界"
    返回 取元素(nblk1_求值_表, nblk1_求值_下标)

  如果 nblk1_求值_种 == "dict.get":
    返回 取值(端口(nblk1_求值_节点, "dict", nblk1_求值_环境), 转文本(端口(nblk1_求值_节点, "key", nblk1_求值_环境)))
  如果 nblk1_求值_种 == "dict.has":
    返回 有键(端口(nblk1_求值_节点, "dict", nblk1_求值_环境), 转文本(端口(nblk1_求值_节点, "key", nblk1_求值_环境)))
  如果 nblk1_求值_种 == "dict.keys":
    返回 键列表(端口(nblk1_求值_节点, "dict", nblk1_求值_环境))

  如果 nblk1_求值_种 == "text.length":
    返回 文本长度(端口(nblk1_求值_节点, "text", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.charAt":
    返回 取字符(端口(nblk1_求值_节点, "text", nblk1_求值_环境), 端口(nblk1_求值_节点, "index", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.slice":
    返回 子串(端口(nblk1_求值_节点, "text", nblk1_求值_环境), 端口(nblk1_求值_节点, "start", nblk1_求值_环境), 端口(nblk1_求值_节点, "length", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.indexOf":
    返回 查找(端口(nblk1_求值_节点, "text", nblk1_求值_环境), 端口(nblk1_求值_节点, "needle", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.contains":
    返回 包含(端口(nblk1_求值_节点, "text", nblk1_求值_环境), 端口(nblk1_求值_节点, "needle", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.split":
    返回 拆分为列表(端口(nblk1_求值_节点, "text", nblk1_求值_环境), 端口(nblk1_求值_节点, "separator", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.splitAt":
    返回 拆分(端口(nblk1_求值_节点, "text", nblk1_求值_环境), 端口(nblk1_求值_节点, "separator", nblk1_求值_环境), 端口(nblk1_求值_节点, "index", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.codePoint":
    返回 字符码(端口(nblk1_求值_节点, "text", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.fromCodePoint":
    返回 码转字符(端口(nblk1_求值_节点, "code", nblk1_求值_环境))
  如果 nblk1_求值_种 == "text.join":
    创建局部变量 nblk1_求值_数 为 字段(nblk1_求值_节点, "count")
    创建局部变量 nblk1_求值_结果 为 ""
    创建局部变量 nblk1_求值_字母 为 "abcdefghijklmnopqrstuvwxyz"
    重复 使用 nblk1_求值_i 共 nblk1_求值_数 次:
      设置局部变量 nblk1_求值_结果 为 连接(nblk1_求值_结果, 转文本(端口(nblk1_求值_节点, 取字符(nblk1_求值_字母, nblk1_求值_i), nblk1_求值_环境)))
    返回 nblk1_求值_结果

  如果 nblk1_求值_种 == "convert.toNumber":
    返回 转数字(端口(nblk1_求值_节点, "text", nblk1_求值_环境))
  如果 nblk1_求值_种 == "convert.toString":
    返回 转文本(端口(nblk1_求值_节点, "value", nblk1_求值_环境))
  如果 nblk1_求值_种 == "convert.toBoolean":
    返回 转布尔(端口(nblk1_求值_节点, "value", nblk1_求值_环境))
  如果 nblk1_求值_种 == "convert.parseJson":
    返回 解析JSON(转文本(端口(nblk1_求值_节点, "text", nblk1_求值_环境)))
  如果 nblk1_求值_种 == "convert.typeOf":
    返回 类型(端口(nblk1_求值_节点, "value", nblk1_求值_环境))

  如果 nblk1_求值_种 == "logic.not":
    返回 真值(端口(nblk1_求值_节点, "value", nblk1_求值_环境)) == 假
  如果 nblk1_求值_种 == "logic.and":
    如果 真值(端口(nblk1_求值_节点, "a", nblk1_求值_环境)) == 假:
      返回 假
    返回 真值(端口(nblk1_求值_节点, "b", nblk1_求值_环境))
  如果 nblk1_求值_种 == "logic.or":
    如果 真值(端口(nblk1_求值_节点, "a", nblk1_求值_环境)):
      返回 真
    返回 真值(端口(nblk1_求值_节点, "b", nblk1_求值_环境))
  如果 nblk1_求值_种 == "logic.compare":
    返回 比较(字段(nblk1_求值_节点, "op"), 端口(nblk1_求值_节点, "a", nblk1_求值_环境), 端口(nblk1_求值_节点, "b", nblk1_求值_环境))

  如果 nblk1_求值_种 == "math.arithmetic":
    创建局部变量 nblk1_求值_数 为 字段(nblk1_求值_节点, "count")
    创建局部变量 nblk1_求值_甲 为 端口(nblk1_求值_节点, "a", nblk1_求值_环境)
    如果 nblk1_求值_数 == 1:
      返回 0 - 转数字(nblk1_求值_甲)
    返回 算(字段(nblk1_求值_节点, "op"), 转数字(nblk1_求值_甲), 转数字(端口(nblk1_求值_节点, "b", nblk1_求值_环境)))
  如果 nblk1_求值_种 == "math.abs":
    创建局部变量 nblk1_求值_值 为 端口(nblk1_求值_节点, "value", nblk1_求值_环境)
    如果 nblk1_求值_值 < 0:
      返回 0 - nblk1_求值_值
    返回 nblk1_求值_值

  如果 nblk1_求值_种 == "func.call":
    返回 空
  如果 子串(nblk1_求值_种, 0, 10) == "func.call:":
    返回 调用函数(子串(nblk1_求值_种, 10, 文本长度(nblk1_求值_种) - 10), 取实参(nblk1_求值_节点, nblk1_求值_环境), nblk1_求值_环境)

  如果 nblk1_求值_种 == "file.read":
    返回 读取文件(端口(nblk1_求值_节点, "path", nblk1_求值_环境))
  如果 nblk1_求值_种 == "file.exists":
    返回 存在(端口(nblk1_求值_节点, "path", nblk1_求值_环境))
  如果 nblk1_求值_种 == "file.list":
    返回 列出文件()
  抛出 连接("nblk1: 不支持的表达式 ", nblk1_求值_种)

定义取值 比较(nblk1_比较_运算, nblk1_比较_甲, nblk1_比较_乙) -> 布尔值:
  如果 nblk1_比较_运算 == "==":
    返回 相等(nblk1_比较_甲, nblk1_比较_乙)
  如果 nblk1_比较_运算 == "!=":
    返回 相等(nblk1_比较_甲, nblk1_比较_乙) == 假
  如果 nblk1_比较_运算 == ">":
    返回 nblk1_比较_甲 > nblk1_比较_乙
  如果 nblk1_比较_运算 == "<":
    返回 nblk1_比较_甲 < nblk1_比较_乙
  如果 nblk1_比较_运算 == ">=":
    返回 nblk1_比较_甲 >= nblk1_比较_乙
  如果 nblk1_比较_运算 == "<=":
    返回 nblk1_比较_甲 <= nblk1_比较_乙
  抛出 连接("nblk1: 未知比较 ", nblk1_比较_运算)

定义取值 相等(nblk1_相等_甲, nblk1_相等_乙) -> 布尔值:
  如果 类型(nblk1_相等_甲) != 类型(nblk1_相等_乙):
    返回 假
  如果 类型(nblk1_相等_甲) == "列表" 或者 类型(nblk1_相等_甲) == "字典":
    返回 转文本(nblk1_相等_甲) == 转文本(nblk1_相等_乙)
  返回 nblk1_相等_甲 == nblk1_相等_乙

定义取值 算(nblk1_算_运算: 文本, nblk1_算_甲: 数字, nblk1_算_乙: 数字) -> 数字:
  如果 nblk1_算_运算 == "+":
    返回 nblk1_算_甲 + nblk1_算_乙
  如果 nblk1_算_运算 == "-":
    返回 nblk1_算_甲 - nblk1_算_乙
  如果 nblk1_算_运算 == "*":
    返回 nblk1_算_甲 * nblk1_算_乙
  如果 nblk1_算_运算 == "/":
    返回 nblk1_算_甲 / nblk1_算_乙
  如果 nblk1_算_运算 == "%":
    返回 nblk1_算_甲 % nblk1_算_乙
  抛出 连接("nblk1: 未知运算 ", nblk1_算_运算)

# ---- 函数调用 ----

定义取值 取实参(nblk1_取实参_节点, nblk1_取实参_环境) -> 列表:
  创建局部变量 nblk1_取实参_值们 为 []
  创建局部变量 nblk1_取实参_id 为 子串(节点类型(nblk1_取实参_节点), 10, 文本长度(节点类型(nblk1_取实参_节点)) - 10)
  创建局部变量 nblk1_取实参_名字们 为 取值(nblk1_g_参数表, nblk1_取实参_id)
  重复 使用 nblk1_取实参_i 共 长度(nblk1_取实参_名字们) 次:
    添加(nblk1_取实参_值们, 端口(nblk1_取实参_节点, 取元素(nblk1_取实参_名字们, nblk1_取实参_i), nblk1_取实参_环境))
  返回 nblk1_取实参_值们

定义取值 调用函数(nblk1_调用函数_id, nblk1_调用函数_实参, nblk1_调用函数_环境) -> 任意:
  如果 有键(nblk1_g_函数表, nblk1_调用函数_id) == 假:
    抛出 连接("nblk1: 未知函数 ", nblk1_调用函数_id)
  创建局部变量 nblk1_调用函数_声明 为 取值(nblk1_g_函数表, nblk1_调用函数_id)
  创建局部变量 nblk1_调用函数_名字们 为 取值(nblk1_g_参数表, nblk1_调用函数_id)
  创建局部变量 nblk1_调用函数_帧 为 {}
  重复 使用 nblk1_调用函数_i 共 长度(nblk1_调用函数_名字们) 次:
    设置键(nblk1_调用函数_帧, 取元素(nblk1_调用函数_名字们, nblk1_调用函数_i), 取元素(nblk1_调用函数_实参, nblk1_调用函数_i))
  添加(nblk1_调用函数_环境, nblk1_调用函数_帧)
  创建局部变量 nblk1_调用函数_信号 为 空
  尝试:
    设置局部变量 nblk1_调用函数_信号 为 执行块(取值(取值(nblk1_调用函数_声明, "inputs"), "body"), nblk1_调用函数_环境)
  捕获 任意 作为 nblk1_调用函数_错误:
    移除(nblk1_调用函数_环境, 长度(nblk1_调用函数_环境) - 1)
    抛出 nblk1_调用函数_错误
  移除(nblk1_调用函数_环境, 长度(nblk1_调用函数_环境) - 1)
  如果 nblk1_调用函数_信号 != 空 并且 取值(nblk1_调用函数_信号, "sig") == "return":
    返回 取值(nblk1_调用函数_信号, "value")
  返回 空

# ---- 语句 ----

定义取值 执行块(nblk1_执行块_体, nblk1_执行块_环境) -> 任意:
  如果 类型(nblk1_执行块_体) != "列表":
    返回 空
  重复 使用 nblk1_执行块_i 共 长度(nblk1_执行块_体) 次:
    如果 nblk1_g_已退出:
      返回 空
    创建局部变量 nblk1_执行块_信号 为 执行语句(取元素(nblk1_执行块_体, nblk1_执行块_i), nblk1_执行块_环境)
    如果 nblk1_执行块_信号 != 空:
      返回 nblk1_执行块_信号
  返回 空

定义取值 执行语句(nblk1_执行语句_节点, nblk1_执行语句_环境) -> 任意:
  设置 nblk1_g_步数 为 nblk1_g_步数 + 1
  如果 nblk1_g_步数 > nblk1_g_步数上限:
    抛出 "nblk1: 执行步数超过上限"
  创建局部变量 nblk1_执行语句_种 为 节点类型(nblk1_执行语句_节点)

  如果 nblk1_执行语句_种 == "control.pass" 或者 nblk1_执行语句_种 == "comment.note":
    返回 空
  如果 nblk1_执行语句_种 == "io.print":
    打印 转文本(端口(nblk1_执行语句_节点, "text", nblk1_执行语句_环境))
    返回 空
  如果 nblk1_执行语句_种 == "var.create":
    建全局(字段(nblk1_执行语句_节点, "name"), 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境), nblk1_执行语句_环境)
    返回 空
  如果 nblk1_执行语句_种 == "var.createLocal":
    建局部(字段(nblk1_执行语句_节点, "name"), 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境), nblk1_执行语句_环境)
    返回 空
  如果 nblk1_执行语句_种 == "var.set":
    写变量(字段(nblk1_执行语句_节点, "variable"), 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境), nblk1_执行语句_环境)
    返回 空
  如果 nblk1_执行语句_种 == "var.setLocal":
    写变量(字段(nblk1_执行语句_节点, "variable"), 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境), nblk1_执行语句_环境)
    返回 空
  如果 nblk1_执行语句_种 == "var.delete":
    返回 空
  如果 nblk1_执行语句_种 == "control.break":
    创建局部变量 nblk1_执行语句_信号 为 {}
    设置键(nblk1_执行语句_信号, "sig", "break")
    返回 nblk1_执行语句_信号
  如果 nblk1_执行语句_种 == "func.return":
    创建局部变量 nblk1_执行语句_信号 为 {}
    设置键(nblk1_执行语句_信号, "sig", "return")
    设置键(nblk1_执行语句_信号, "value", 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境))
    返回 nblk1_执行语句_信号
  如果 nblk1_执行语句_种 == "sys.exit":
    设置 nblk1_g_已退出 为 真
    返回 空
  如果 nblk1_执行语句_种 == "control.if":
    返回 执行如果(nblk1_执行语句_节点, nblk1_执行语句_环境)
  如果 nblk1_执行语句_种 == "control.while":
    返回 执行当(nblk1_执行语句_节点, nblk1_执行语句_环境)
  如果 nblk1_执行语句_种 == "control.repeat":
    返回 执行重复(端口(nblk1_执行语句_节点, "times", nblk1_执行语句_环境), 空, nblk1_执行语句_节点, nblk1_执行语句_环境)
  如果 nblk1_执行语句_种 == "control.repeatWith":
    返回 执行重复(端口(nblk1_执行语句_节点, "times", nblk1_执行语句_环境), 字段(nblk1_执行语句_节点, "variable"), nblk1_执行语句_节点, nblk1_执行语句_环境)
  如果 nblk1_执行语句_种 == "control.forever":
    返回 执行无限(nblk1_执行语句_节点, nblk1_执行语句_环境)
  如果 nblk1_执行语句_种 == "control.forEach":
    返回 执行对每项(nblk1_执行语句_节点, nblk1_执行语句_环境)
  如果 nblk1_执行语句_种 == "control.try":
    返回 执行尝试(nblk1_执行语句_节点, nblk1_执行语句_环境)
  如果 nblk1_执行语句_种 == "control.throw":
    创建局部变量 nblk1_执行语句_信号 为 {}
    设置键(nblk1_执行语句_信号, "sig", "throw")
    设置键(nblk1_执行语句_信号, "value", 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境))
    返回 nblk1_执行语句_信号
  如果 nblk1_执行语句_种 == "control.wait":
    返回 空
  如果 nblk1_执行语句_种 == "list.add":
    添加(端口(nblk1_执行语句_节点, "items", nblk1_执行语句_环境), 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境))
    返回 空
  如果 nblk1_执行语句_种 == "list.set":
    创建局部变量 nblk1_执行语句_表 为 端口(nblk1_执行语句_节点, "items", nblk1_执行语句_环境)
    设置元素(nblk1_执行语句_表, 端口(nblk1_执行语句_节点, "index", nblk1_执行语句_环境), 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境))
    返回 空
  如果 nblk1_执行语句_种 == "list.remove":
    移除(端口(nblk1_执行语句_节点, "items", nblk1_执行语句_环境), 端口(nblk1_执行语句_节点, "index", nblk1_执行语句_环境))
    返回 空
  如果 nblk1_执行语句_种 == "dict.set":
    设置键(端口(nblk1_执行语句_节点, "dict", nblk1_执行语句_环境), 转文本(端口(nblk1_执行语句_节点, "key", nblk1_执行语句_环境)), 端口(nblk1_执行语句_节点, "value", nblk1_执行语句_环境))
    返回 空
  如果 nblk1_执行语句_种 == "file.write":
    写入文件(端口(nblk1_执行语句_节点, "path", nblk1_执行语句_环境), 转文本(端口(nblk1_执行语句_节点, "content", nblk1_执行语句_环境)))
    返回 空
  如果 nblk1_执行语句_种 == "file.delete":
    删除文件(端口(nblk1_执行语句_节点, "path", nblk1_执行语句_环境))
    返回 空
  如果 nblk1_执行语句_种 == "os.exec_command":
    抛出 "nblk1: 暂不支持执行命令"
  如果 子串(nblk1_执行语句_种, 0, 10) == "func.call:":
    返回 求值(nblk1_执行语句_节点, nblk1_执行语句_环境)
  抛出 连接("nblk1: 不支持的语句 ", nblk1_执行语句_种)

定义取值 信号类别(nblk1_信号类别_信号) -> 文本:
  如果 nblk1_信号类别_信号 == 空:
    返回 ""
  如果 类型(nblk1_信号类别_信号) != "字典":
    返回 ""
  返回 取值(nblk1_信号类别_信号, "sig")

定义取值 执行无限(nblk1_执行无限_节点, nblk1_执行无限_环境) -> 任意:
  当 真:
    创建局部变量 nblk1_执行无限_信号 为 执行块(取值(取值(nblk1_执行无限_节点, "inputs"), "body"), nblk1_执行无限_环境)
    如果 信号类别(nblk1_执行无限_信号) == "break":
      返回 空
    如果 nblk1_执行无限_信号 != 空:
      返回 nblk1_执行无限_信号
    如果 nblk1_g_已退出:
      返回 空
  返回 空

定义取值 执行如果(nblk1_执行如果_节点, nblk1_执行如果_环境) -> 任意:
  如果 真值(端口(nblk1_执行如果_节点, "condition", nblk1_执行如果_环境)):
    返回 执行块(取值(取值(nblk1_执行如果_节点, "inputs"), "then"), nblk1_执行如果_环境)
  创建局部变量 nblk1_执行如果_数 为 字段(nblk1_执行如果_节点, "elseIfs")
  创建局部变量 nblk1_执行如果_i 为 1
  当 nblk1_执行如果_i <= nblk1_执行如果_数:
    如果 真值(字段(nblk1_执行如果_节点, 连接("elseIf", 转文本(nblk1_执行如果_i)))):
      创建局部变量 nblk1_执行如果_体 为 取值(取值(nblk1_执行如果_节点, "inputs"), 连接(连接("elseIf", 转文本(nblk1_执行如果_i)), "Body"))
      返回 执行块(nblk1_执行如果_体, nblk1_执行如果_环境)
    设置局部变量 nblk1_执行如果_i 为 nblk1_执行如果_i + 1
  返回 执行块(取值(取值(nblk1_执行如果_节点, "inputs"), "else"), nblk1_执行如果_环境)

定义取值 执行当(nblk1_执行当_节点, nblk1_执行当_环境) -> 任意:
  当 真值(端口(nblk1_执行当_节点, "condition", nblk1_执行当_环境)):
    创建局部变量 nblk1_执行当_信号 为 执行块(取值(取值(nblk1_执行当_节点, "inputs"), "body"), nblk1_执行当_环境)
    如果 信号类别(nblk1_执行当_信号) == "break":
      返回 空
    如果 nblk1_执行当_信号 != 空:
      返回 nblk1_执行当_信号
    如果 nblk1_g_已退出:
      返回 空
  返回 空

定义取值 执行重复(nblk1_执行重复_次数, nblk1_执行重复_变量, nblk1_执行重复_节点, nblk1_执行重复_环境) -> 任意:
  创建局部变量 nblk1_执行重复_剩余 为 转数字(nblk1_执行重复_次数)
  创建局部变量 nblk1_执行重复_i 为 0
  当 nblk1_执行重复_剩余 > 0:
    如果 nblk1_执行重复_变量 != 空:
      如果 nblk1_执行重复_变量 != "":
        赋值(转文本(nblk1_执行重复_变量), nblk1_执行重复_i, nblk1_执行重复_环境)
    创建局部变量 nblk1_执行重复_信号 为 执行块(取值(取值(nblk1_执行重复_节点, "inputs"), "body"), nblk1_执行重复_环境)
    如果 信号类别(nblk1_执行重复_信号) == "break":
      返回 空
    如果 nblk1_执行重复_信号 != 空:
      返回 nblk1_执行重复_信号
    如果 nblk1_g_已退出:
      返回 空
    设置局部变量 nblk1_执行重复_剩余 为 nblk1_执行重复_剩余 - 1
    设置局部变量 nblk1_执行重复_i 为 nblk1_执行重复_i + 1
  返回 空

定义取值 执行对每项(nblk1_执行对每项_节点, nblk1_执行对每项_环境) -> 任意:
  创建局部变量 nblk1_执行对每项_项们 为 端口(nblk1_执行对每项_节点, "items", nblk1_执行对每项_环境)
  如果 类型(nblk1_执行对每项_项们) != "列表":
    抛出 "nblk1: 对每项需要列表"
  创建局部变量 nblk1_执行对每项_变量 为 转文本(字段(nblk1_执行对每项_节点, "variable"))
  创建局部变量 nblk1_执行对每项_i 为 0
  当 nblk1_执行对每项_i < 长度(nblk1_执行对每项_项们):
    如果 变量存在(nblk1_执行对每项_变量, nblk1_执行对每项_环境):
      写变量(nblk1_执行对每项_变量, 取元素(nblk1_执行对每项_项们, nblk1_执行对每项_i), nblk1_执行对每项_环境)
    否则:
      建全局(nblk1_执行对每项_变量, 取元素(nblk1_执行对每项_项们, nblk1_执行对每项_i), nblk1_执行对每项_环境)
    创建局部变量 nblk1_执行对每项_信号 为 执行块(取值(取值(nblk1_执行对每项_节点, "inputs"), "body"), nblk1_执行对每项_环境)
    如果 信号类别(nblk1_执行对每项_信号) == "break":
      返回 空
    如果 nblk1_执行对每项_信号 != 空:
      返回 nblk1_执行对每项_信号
    如果 nblk1_g_已退出:
      返回 空
    设置局部变量 nblk1_执行对每项_i 为 nblk1_执行对每项_i + 1
  返回 空

定义取值 执行尝试(nblk1_执行尝试_节点, nblk1_执行尝试_环境) -> 任意:
  创建局部变量 nblk1_执行尝试_信号 为 空
  尝试:
    设置局部变量 nblk1_执行尝试_信号 为 执行块(取值(取值(nblk1_执行尝试_节点, "inputs"), "body"), nblk1_执行尝试_环境)
  捕获 任意 作为 nblk1_执行尝试_g_消息:
    设置局部变量 nblk1_执行尝试_信号 为 {}
    设置键(nblk1_执行尝试_信号, "sig", "error")
    设置键(nblk1_执行尝试_信号, "value", nblk1_执行尝试_g_消息)
  如果 nblk1_执行尝试_信号 == 空:
    返回 空
  创建局部变量 nblk1_执行尝试_类别 为 信号类别(nblk1_执行尝试_信号)
  如果 nblk1_执行尝试_类别 == "break" 或者 nblk1_执行尝试_类别 == "return":
    返回 nblk1_执行尝试_信号
  创建局部变量 nblk1_执行尝试_捕获们 为 取值(取值(nblk1_执行尝试_节点, "inputs"), "catches")
  重复 使用 nblk1_执行尝试_i 共 长度(nblk1_执行尝试_捕获们) 次:
    创建局部变量 nblk1_执行尝试_分支 为 取元素(nblk1_执行尝试_捕获们, nblk1_执行尝试_i)
    创建局部变量 nblk1_执行尝试_过滤 为 转文本(字段(nblk1_执行尝试_分支, "exception"))
    如果 匹配(nblk1_执行尝试_过滤, nblk1_执行尝试_信号):
      创建局部变量 nblk1_执行尝试_目标 为 字段(nblk1_执行尝试_分支, "target")
      如果 nblk1_执行尝试_目标 != 空:
        如果 nblk1_执行尝试_目标 != "":
          建全局(转文本(nblk1_执行尝试_目标), 转文本(取值(nblk1_执行尝试_信号, "value")), nblk1_执行尝试_环境)
      返回 执行块(取值(取值(nblk1_执行尝试_分支, "inputs"), "body"), nblk1_执行尝试_环境)
  返回 nblk1_执行尝试_信号

定义取值 匹配(nblk1_匹配_过滤, nblk1_匹配_信号) -> 布尔值:
  如果 nblk1_匹配_过滤 == "any" 或者 nblk1_匹配_过滤 == "任意":
    返回 真
  创建局部变量 nblk1_匹配_值 为 取值(nblk1_匹配_信号, "value")
  如果 nblk1_匹配_过滤 == "error" 或者 nblk1_匹配_过滤 == "错误":
    返回 信号类别(nblk1_匹配_信号) == "error"
  如果 nblk1_匹配_过滤 == "text" 或者 nblk1_匹配_过滤 == "文本":
    返回 类型(nblk1_匹配_值) == "文本"
  如果 nblk1_匹配_过滤 == "number" 或者 nblk1_匹配_过滤 == "数字":
    返回 类型(nblk1_匹配_值) == "数字"
  如果 nblk1_匹配_过滤 == "boolean" 或者 nblk1_匹配_过滤 == "布尔值":
    返回 类型(nblk1_匹配_值) == "布尔值"
  如果 nblk1_匹配_过滤 == "list" 或者 nblk1_匹配_过滤 == "列表":
    返回 类型(nblk1_匹配_值) == "列表"
  如果 nblk1_匹配_过滤 == "dict" 或者 nblk1_匹配_过滤 == "字典":
    返回 类型(nblk1_匹配_值) == "字典"
  返回 假

定义操作 执行项目(nblk1_执行项目_g_项目):
  设置 nblk1_g_步数 为 0
  设置 nblk1_g_已退出 为 假
  创建局部变量 nblk1_执行项目_环境 为 [{}]
  重复 使用 nblk1_执行项目_i 共 长度(取值(nblk1_执行项目_g_项目, "scripts")) 次:
    创建局部变量 nblk1_执行项目_脚本 为 取元素(取值(nblk1_执行项目_g_项目, "scripts"), nblk1_执行项目_i)
    如果 取值(nblk1_执行项目_脚本, "type") == "control.start":
      设置 nblk1_g_临时 为 执行块(取值(取值(nblk1_执行项目_脚本, "inputs"), "body"), nblk1_执行项目_环境)

开始:
  创建变量 nblk1_g_函数表 为 {}
  创建变量 nblk1_g_参数表 为 {}
  创建变量 nblk1_g_步数 为 0
  创建变量 nblk1_g_步数上限 为 5000000
  创建变量 nblk1_g_已退出 为 假
  创建变量 nblk1_g_临时 为 空
  创建变量 nblk1_g_文件们 为 参数()
  创建变量 nblk1_g_程序参数 为 []
  创建变量 nblk1_g_起 为 1
  当 nblk1_g_起 < 长度(nblk1_g_文件们):
    添加(nblk1_g_程序参数, 取元素(nblk1_g_文件们, nblk1_g_起))
    设置 nblk1_g_起 为 nblk1_g_起 + 1
  如果 长度(nblk1_g_文件们) < 1:
    打印 "用法：nblk1 <项目.ir.json>"
    退出程序 2
  尝试:
    创建变量 nblk1_g_文本 为 读取文件(取元素(nblk1_g_文件们, 0))
    创建变量 nblk1_g_项目 为 解析JSON(nblk1_g_文本)
    装载(nblk1_g_项目)
    执行项目(nblk1_g_项目)
  捕获 任意 作为 nblk1_g_消息:
    打印 连接("nblk1: 运行失败：", nblk1_g_消息)
    退出程序 1
