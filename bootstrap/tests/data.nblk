项目 "Data"
语言 zh-CN

开始:
  创建变量 xs 为 [1, 2, 3]
  添加(xs, 4)
  设置元素(xs, 0, 10)
  打印 长度(xs)
  打印 取元素(xs, 0)
  移除(xs, 1)
  打印 连接(转文本(xs), "")
  创建变量 d 为 解析JSON("{\"a\": 1, \"b\": [true, null]}")
  打印 取值(d, "a")
  设置键(d, "c", "x")
  打印 有键(d, "c")
  打印 连接(转文本(键列表(d)), "")
  打印 包含("hello", "ell")
  打印 拆分("a,b,c", ",", 1)
  打印 拆分为列表("a,b,c", ",")
  打印 类型(xs)
  打印 类型(d)
  打印 类型(1)
  打印 类型("s")
  打印 类型(真)
  打印 类型(空)
  打印 转布尔(0)
  打印 转布尔(1)
  打印 转数字("42") + 1
  打印 转文本(42)
